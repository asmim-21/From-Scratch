{
  "name": "from-scratch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content": "node scripts/run-python.mjs scripts/build_content.py",
    "check": "node scripts/run-python.mjs scripts/build_content.py --check",
    "build": "npm run content && tsc --noEmit && vite build && npm run stubs",
    "stubs": "node scripts/run-python.mjs scripts/build_content.py --stubs dist",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "page-flip": "2.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "prettier": "3.10.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8"
  }
}
